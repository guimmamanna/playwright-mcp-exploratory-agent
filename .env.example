# Target application under test
EXPLORATORY_BASE_URL=https://demo.playwright.dev/todomvc

# Optional: Google AI Studio key for live AI reasoning (free tier)
# https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Optional LLM fallbacks (paid tiers may apply)
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# LLM_API_KEY=

# Vision (mock provider used when unset)
# VISION_API_KEY=
# OPENAI_API_KEY=

# Browser
HEADLESS=true

# Dashboard report directories (comma-separated, relative to repo root)
EXPLORATORY_REPORTS_DIR=examples/reports
